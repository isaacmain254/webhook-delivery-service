PORT=5000
NODE_ENV=development

# Use a random secret with at least 32 characters. Keep it private and stable.
API_KEY_HASH_SECRET=replace-with-at-least-32-characters

# Worker and delivery policy
REDIS_URL=redis://localhost:6379
MAX_DELIVERY_ATTEMPTS=5
INITIAL_RETRY_DELAY_MS=1000
MAX_RETRY_DELAY_MS=3600000
DELIVERY_TIMEOUT_MS=30000
WORKER_CONCURRENCY=5
LEASE_DURATION_MS=120000
REQUIRE_HTTPS_DESTINATIONS=true

DATABASE_USER=webhook_service_user
DATABASE_PASSWORD=webhook_service_password
DATABASE_NAME=webhook_service_database

# Use localhost when running Prisma commands from the host machine.
DATABASE_URL=postgresql://webhook_service_user:webhook_service_password@localhost:5432/webhook_service_database?schema=public
