// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String            @id @default(uuid())
  username   String            @unique
  apiKeyHash String
  endpoints  WebhookEndpoint[]
  events     Event[]
  deliveries Delivery[]
}

// Stores the webhook destination registered by a user.
model WebhookEndpoint {
  id            String         @id @default(uuid())
  owner         String
  url           String
  signingSecret String
  status        EndpointStatus
  createdOn     DateTime       @default(now())
  updatedOn     DateTime       @updatedAt
  user          User           @relation(fields: [owner], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  deliveries    Delivery[]
}

// Connects endpoints to event types they want to receive.
model Subscription {
  id         String          @id @default(uuid())
  endpointId String
  event      String[]
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId])
}

// Stores the original event submitted by the client.
model Event {
  id             String     @id @default(uuid())
  userId         String
  idempotencyKey String
  event          String
  payload        Json
  createdOn      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries     Delivery[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
}

// Represents the attempt to deliver a particular event to a particular endpoint.
model Delivery {
  id            String             @id @default(uuid())
  userId        String
  eventId       String
  endpointId    String
  status        DeliveryStatus
  retryCount    Int?
  nextAttempt   DateTime?
  lockedUntil   DateTime?
  lockedBy      String?
  statusCode    String?
  response      String?
  duration      String?
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint      WebhookEndpoint    @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts      DeliveryAttempts[]
  outboxRecords OutboxRecord[]

  @@unique([eventId, endpointId])
  @@index([status])
  @@index([lockedUntil])
  @@index([status, lockedUntil])
  @@index([userId])
  @@index([endpointId])
}

// Records each individual HTTP delivery attempt.
model DeliveryAttempts {
  id           Int       @id @default(autoincrement())
  deliveryId   String
  attemptCount Int
  startedAt    DateTime
  completedAt  DateTime?
  statusCode   String?
  response     String?
  duration     String
  delivery     Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
}

model OutboxRecord {
  id          String    @id @default(uuid())
  deliveryId  String    @unique
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([published, createdAt])
}

enum EndpointStatus {
  ACTIVE
  INACTIVE
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  RETRYING
  SUCCEEDED
  FAILED
}
